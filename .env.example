# Copie para .env SOMENTE no computador/host que executa o bot.
# Nunca envie .env para o GitHub.
DISCORD_TOKEN=
# Gere uma senha longa e aleatoria. Pelo menos 32 caracteres.
PANEL_PASSWORD=
ALLOWED_ORIGINS=https://iamkyo22.github.io,http://localhost:3000
PORT=3000

# Opcional: IA real. Defina somente no ambiente privado do servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Pode usar um modelo diferente para DMs, conforme acesso e orçamento.
OPENAI_DM_MODEL=gpt-6-astra
# Monte uma pasta/volume persistente. Não coloque dentro de uma pasta pública.
AI_DATA_DIR=./data
